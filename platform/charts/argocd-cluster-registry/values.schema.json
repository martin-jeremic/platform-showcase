{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "argocd-cluster-registry values",
  "type": "object",
  "required": ["argocdNamespace", "externalSecrets"],
  "additionalProperties": true,
  "properties": {
    "argocdNamespace": { "type": "string", "minLength": 1 },
    "externalSecrets": {
      "type": "object",
      "required": ["refreshInterval", "secretStoreRef"],
      "properties": {
        "refreshInterval": { "type": "string" },
        "secretStoreRef": {
          "type": "object",
          "required": ["name", "kind"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["ClusterSecretStore", "SecretStore"] }
          }
        }
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "server", "akvKey"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "server": { "type": "string", "pattern": "^https://" },
          "caData": { "type": "string" },
          "insecure": { "type": "boolean" },
          "project": { "type": "string" },
          "akvKey": { "type": "string", "minLength": 1 },
          "labels": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "sourceRepos": { "type": "array", "items": { "type": "string" } },
          "destinations": { "type": "array", "items": { "type": "object" } },
          "clusterResourceWhitelist": { "type": "array", "items": { "type": "object" } },
          "namespaceResourceWhitelist": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
