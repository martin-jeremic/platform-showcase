# Copy to argocd/.env (gitignored) and fill in. Read by setup.sh only.
# setup.sh wires the HUB (argocd-hub): stage and demo. Prod's Argo CD runs in-cluster on
# aks-product-a-prod and is bootstrapped by hand (setup/prod/README.md); there is deliberately
# no PROD_CONTEXT here.
ADO_TOKEN=          # Azure DevOps token, Code (Read)
ACR_USER=           # registry pull token name or service principal app id
ACR_PASS=           # registry pull token password or service principal secret
HUB_CONTEXT=        # kube-context of hub-dev
STAGE_CONTEXT=      # kube-context of product-a-stage
DEMO_CONTEXT=       # kube-context of aks-product-a-demo
