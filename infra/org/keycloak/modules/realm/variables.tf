# ---------------------------------------------------------------------------
# modules/realm -- one Keycloak realm and everything custom inside it.
#
# Every input is typed. An omitted optional field means "provider default or
# computed from live", never an invented value. Roots do not write these blocks
# by hand: ../../../../scripts/keycloak/kc_export.py generates them from a live realm,
# and a re-run must produce no diff.
#
# Trimmed for the showcase: organisations, user profile, events, required actions
# and SMTP are omitted; the patterns below are the ones that carry the lessons.
# ---------------------------------------------------------------------------

variable "realm" {
  description = "Realm name. Also the import id of the realm and the `realm_id` of every child resource."
  type        = string

  validation {
    condition     = var.realm != "master"
    error_message = "The master realm is out of scope by decision; it is the bootstrap and admin realm and holds the stack's own credential."
  }
}

# Field semantics follow the provider exactly: fields the provider marks
# Optional+Computed default to null here, so an omitted value is read from live and
# never planned; fields with a provider Default get the SAME default here, so the
# module never sends something the provider would not have sent.
variable "settings" {
  description = "Realm-level settings, generated by the exporter."
  type = object({
    enabled      = optional(bool, true)
    display_name = optional(string)

    registration_allowed           = optional(bool)
    registration_email_as_username = optional(bool)
    edit_username_allowed          = optional(bool)
    reset_password_allowed         = optional(bool)
    remember_me                    = optional(bool)
    verify_email                   = optional(bool)
    login_with_email_allowed       = optional(bool)
    duplicate_emails_allowed       = optional(bool)
    ssl_required                   = optional(string, "external")

    # Go duration strings ("5m", "10h"); the provider compares them numerically.
    default_signature_algorithm  = optional(string)
    revoke_refresh_token         = optional(bool, false)
    sso_session_idle_timeout     = optional(string)
    sso_session_max_lifespan     = optional(string)
    offline_session_idle_timeout = optional(string)
    access_token_lifespan        = optional(string)
    access_code_lifespan         = optional(string)

    browser_flow               = optional(string)
    registration_flow          = optional(string)
    direct_grant_flow          = optional(string)
    reset_credentials_flow     = optional(string)
    client_authentication_flow = optional(string)
    docker_authentication_flow = optional(string)
    first_broker_login_flow    = optional(string)

    attributes = optional(map(string))

    security_headers = optional(object({
      x_frame_options                     = optional(string, "SAMEORIGIN")
      content_security_policy             = optional(string, "frame-src 'self'; frame-ancestors 'self'; object-src 'none';")
      content_security_policy_report_only = optional(string, "")
      x_content_type_options              = optional(string, "nosniff")
      x_robots_tag                        = optional(string, "none")
      x_xss_protection                    = optional(string, "1; mode=block")
      strict_transport_security           = optional(string, "max-age=31536000; includeSubDomains")
      referrer_policy                     = optional(string, "no-referrer")
    }))

    # Presence turns brute-force protection ON; null leaves it off.
    brute_force_detection = optional(object({
      permanent_lockout          = optional(bool, false)
      max_login_failures         = optional(number, 30)
      wait_increment_seconds     = optional(number, 60)
      max_failure_wait_seconds   = optional(number, 900)
      failure_reset_time_seconds = optional(number, 43200)
    }))
  })
}

variable "groups" {
  description = "Top-level groups keyed by name. Role mappings are authoritative when declared; membership is never managed."
  type = map(object({
    description  = optional(string)
    attributes   = optional(map(string))
    realm_roles  = optional(set(string), [])
    client_roles = optional(map(set(string)), {})
  }))
  default = {}
}

# Both AUTHORITATIVE and reconciling: a scope missing from the list is unmarked as
# a realm default on apply. The lists are therefore the full live lists, built-in
# scopes included. Importable by realm id.
variable "default_client_scopes" {
  description = "Client scopes new clients get as default scopes (keycloak_realm_default_client_scopes). null leaves them unmanaged."
  type        = set(string)
  default     = null
}

variable "optional_client_scopes" {
  description = "Client scopes new clients get as optional scopes (keycloak_realm_optional_client_scopes). null leaves them unmanaged."
  type        = set(string)
  default     = null
}

variable "default_roles" {
  description = "Realm default roles by name; client roles as \"<clientId>/<role>\" (keycloak_default_roles). null leaves them unmanaged."
  type        = set(string)
  default     = null
}

variable "client_scopes" {
  description = "Custom OpenID client scopes keyed by name, with their protocol mappers keyed by mapper name."
  type = map(object({
    description                         = optional(string)
    consent_screen_text                 = optional(string)
    include_in_token_scope              = optional(bool, true)
    include_in_openid_provider_metadata = optional(bool, true)
    gui_order                           = optional(number)
    protocol_mappers = optional(map(object({
      protocol_mapper = string
      protocol        = optional(string, "openid-connect")
      config          = map(string)
    })), {})
  }))
  default = {}
}

variable "roles" {
  description = "Custom realm roles keyed by name. `composite_roles` may only name other roles in this map."
  type = map(object({
    description     = optional(string)
    attributes      = optional(map(string))
    composite_roles = optional(set(string))
  }))
  default = {}

  validation {
    condition = alltrue(flatten([
      for name, role in var.roles : [
        for c in coalesce(role.composite_roles, []) :
        contains(keys(var.roles), c) && length(coalesce(try(var.roles[c].composite_roles, null), [])) == 0
      ]
    ]))
    error_message = "composite_roles must reference realm roles declared in this module that are themselves flat (one level of composition)."
  }
}

# Defaults mirror the provider's defaults where it has them and the admin
# console's create-form defaults where the provider computes the value. The
# exporter writes every flag explicitly anyway; the defaults matter for blocks
# written by hand.
variable "clients" {
  description = "OpenID Connect clients keyed by clientId."
  type = map(object({
    name                      = optional(string)
    description               = optional(string)
    enabled                   = optional(bool, true)
    access_type               = optional(string, "PUBLIC")
    client_authenticator_type = optional(string, "client-secret")

    standard_flow_enabled        = optional(bool, true)
    implicit_flow_enabled        = optional(bool, false)
    direct_access_grants_enabled = optional(bool, false)
    service_accounts_enabled     = optional(bool, false)

    root_url  = optional(string)
    base_url  = optional(string)
    admin_url = optional(string)

    # Sent only when a flow that can use them is enabled; see clients.tf.
    valid_redirect_uris             = optional(set(string))
    valid_post_logout_redirect_uris = optional(set(string))
    web_origins                     = optional(set(string))

    pkce_code_challenge_method = optional(string)
    full_scope_allowed         = optional(bool, true)
    consent_required           = optional(bool, false)
    display_on_consent_screen  = optional(bool, false)
    consent_screen_text        = optional(string)
    login_theme                = optional(string)
    always_display_in_console  = optional(bool, false)

    frontchannel_logout_enabled                = optional(bool, true)
    frontchannel_logout_url                    = optional(string)
    backchannel_logout_url                     = optional(string)
    backchannel_logout_session_required        = optional(bool, true)
    backchannel_logout_revoke_offline_sessions = optional(bool, false)

    use_refresh_tokens                             = optional(bool, true)
    use_refresh_tokens_client_credentials          = optional(bool, false)
    standard_token_exchange_enabled                = optional(bool, false)
    allow_refresh_token_in_standard_token_exchange = optional(string)
    oauth2_device_authorization_grant_enabled      = optional(bool, false)
    oauth2_device_code_lifespan                    = optional(string)
    oauth2_device_polling_interval                 = optional(string)
    oauth2_jwt_authorization_grant_enabled         = optional(bool, false)
    oauth2_jwt_authorization_grant_idp             = optional(string)

    exclude_session_state_from_auth_response = optional(bool)
    exclude_issuer_from_auth_response        = optional(bool)
    require_dpop_bound_tokens                = optional(bool)

    access_token_lifespan               = optional(string)
    client_session_idle_timeout         = optional(string)
    client_session_max_lifespan         = optional(string)
    client_offline_session_idle_timeout = optional(string)
    client_offline_session_max_lifespan = optional(string)

    # Client attributes without a first-class argument. Only the listed keys are
    # tracked by the provider; never put an empty string here (the provider treats
    # "" as "delete this attribute").
    extra_config = optional(map(string), {})

    # Presence turns authorization services ON. The model underneath (resources,
    # policies, permissions) is not managed here.
    authorization = optional(object({
      policy_enforcement_mode          = optional(string, "ENFORCING")
      decision_strategy                = optional(string, "UNANIMOUS")
      allow_remote_resource_management = optional(bool, false)
      keep_defaults                    = optional(bool, false)
    }))

    # Flow aliases (resolved to ids in clients.tf).
    authentication_flow_binding_overrides = optional(object({
      browser      = optional(string)
      direct_grant = optional(string)
    }))

    # Both AUTHORITATIVE: the full live lists, built-in scopes included.
    default_scopes  = set(string)
    optional_scopes = set(string)

    protocol_mappers = optional(map(object({
      protocol_mapper = string
      protocol        = optional(string, "openid-connect")
      config          = map(string)
    })), {})

    roles = optional(map(object({
      description = optional(string)
      attributes  = optional(map(string))
    })), {})

    # Service-account role mappings. Client roles are keyed by the container
    # client's clientId (e.g. "realm-management" = ["manage-users"]).
    service_account_realm_roles  = optional(set(string), [])
    service_account_client_roles = optional(map(set(string)), {})
  }))
  default = {}

  validation {
    condition     = alltrue([for k, c in var.clients : contains(["PUBLIC", "CONFIDENTIAL", "BEARER-ONLY"], c.access_type)])
    error_message = "access_type must be PUBLIC, CONFIDENTIAL or BEARER-ONLY."
  }

  validation {
    condition     = alltrue([for k, c in var.clients : c.pkce_code_challenge_method == null || contains(["plain", "S256"], c.pkce_code_challenge_method)])
    error_message = "pkce_code_challenge_method must be null (not enforced), \"plain\" or \"S256\". Never \"\"."
  }

  validation {
    condition     = alltrue([for k, c in var.clients : alltrue([for ek, ev in c.extra_config : ev != ""])])
    error_message = "extra_config values must not be empty strings; the provider treats \"\" as a deletion."
  }

  validation {
    condition     = alltrue([for k, c in var.clients : length(c.service_account_realm_roles) == 0 && length(c.service_account_client_roles) == 0 || c.service_accounts_enabled])
    error_message = "service_account_*_roles require service_accounts_enabled = true."
  }
}

variable "identity_providers" {
  description = "Brokered identity providers keyed by alias. provider_id selects the resource: oidc / keycloak-oidc -> keycloak_oidc_identity_provider, microsoft -> keycloak_oidc_microsoft_identity_provider."
  type = map(object({
    provider_id                   = string
    display_name                  = optional(string)
    enabled                       = optional(bool, true)
    store_token                   = optional(bool, false)
    add_read_token_role_on_create = optional(bool, false)
    authenticate_by_default       = optional(bool, false)
    link_only                     = optional(bool, false)
    hide_on_login_page            = optional(bool, false)
    trust_email                   = optional(bool, false)
    first_broker_login_flow_alias = optional(string, "first broker login")
    post_broker_login_flow_alias  = optional(string)
    gui_order                     = optional(string)
    sync_mode                     = optional(string, "LEGACY")

    client_id                               = string
    default_scopes                          = optional(string)
    accepts_prompt_none_forward_from_client = optional(bool, false)
    disable_user_info                       = optional(bool, false)

    # Config keys without a first-class argument (clientAuthMethod, pkceEnabled,
    # showInAccountConsole, ...). Only the listed keys are tracked.
    extra_config = optional(map(string), {})

    # oidc / keycloak-oidc only
    authorization_url        = optional(string)
    token_url                = optional(string)
    user_info_url            = optional(string)
    jwks_url                 = optional(string)
    logout_url               = optional(string)
    issuer                   = optional(string)
    login_hint               = optional(string)
    backchannel_supported    = optional(bool, false)
    validate_signature       = optional(bool, false)
    ui_locales               = optional(bool, false)
    disable_type_claim_check = optional(bool, false)

    # microsoft only
    tenant_id = optional(string)
    prompt    = optional(string)

    mappers = optional(map(object({
      identity_provider_mapper = string
      config                   = map(string)
    })), {})
  }))
  default = {}

  validation {
    condition     = alltrue([for k, p in var.identity_providers : contains(["oidc", "keycloak-oidc", "microsoft"], p.provider_id)])
    error_message = "provider_id must be oidc, keycloak-oidc or microsoft. Other broker types need a new resource mapping in identity-providers.tf."
  }

  validation {
    condition     = alltrue([for k, p in var.identity_providers : p.provider_id == "microsoft" || (p.authorization_url != null && p.token_url != null)])
    error_message = "oidc identity providers need authorization_url and token_url."
  }
}

# The secret is REQUIRED by the provider for these resources, but the admin API
# only ever returns the mask, so the mask is what an import writes to state and
# what config must hold to plan clean. identity-providers.tf additionally pins
# the field with ignore_changes. To rotate: set the real value here AND remove
# the lifecycle block, in one deliberate change.
variable "identity_provider_secrets" {
  description = "Client secret per identity-provider alias. Missing aliases use the mask."
  type        = map(string)
  sensitive   = true
  default     = {}
}

# The flow tree is flattened into three maps because HCL variable types cannot
# be recursive. Two nesting levels of subflows are supported, which is what
# Keycloak's own built-in flows use.
variable "authentication_flows" {
  description = "Custom top-level flows keyed by alias."
  type = map(object({
    description = optional(string)
    provider_id = optional(string, "basic-flow")
  }))
  default = {}
}

variable "authentication_subflows" {
  description = "Subflows keyed by alias. `parent_flow` is a top-level flow alias or another subflow alias (one extra level)."
  type = map(object({
    parent_flow   = string
    description   = optional(string)
    provider_id   = optional(string, "basic-flow")
    authenticator = optional(string)
    requirement   = optional(string, "DISABLED")
    priority      = number
  }))
  default = {}

  validation {
    condition = alltrue([
      for k, s in var.authentication_subflows :
      contains(keys(var.authentication_flows), s.parent_flow) ||
      (contains(keys(var.authentication_subflows), s.parent_flow) && contains(keys(var.authentication_flows), var.authentication_subflows[s.parent_flow].parent_flow))
    ])
    error_message = "A subflow's parent must be a top-level flow or a subflow whose own parent is a top-level flow (two levels maximum)."
  }
}

variable "authentication_executions" {
  description = "Executions keyed by \"<parent alias>/<n>\". `priority` is explicit: the provider does not compute it and 0 would reorder the flow."
  type = map(object({
    parent_flow   = string
    authenticator = string
    requirement   = optional(string, "DISABLED")
    priority      = number
    config = optional(object({
      alias  = string
      config = map(string)
    }))
  }))
  default = {}

  validation {
    condition = alltrue([
      for k, e in var.authentication_executions :
      contains(keys(var.authentication_flows), e.parent_flow) || contains(keys(var.authentication_subflows), e.parent_flow)
    ])
    error_message = "An execution's parent_flow must be a declared flow or subflow alias."
  }
}
