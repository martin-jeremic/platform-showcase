# Connection to the production instance. Realm CONTENT is not a variable: each realm
# is a `module` block in its own realm-*.tf file, generated by the exporter.

variable "keycloak_url" {
  description = "Base URL of the production instance, without the relative path."
  type        = string
  default     = "https://services.example.com"
}

variable "keycloak_base_path" {
  description = "Relative path the instance is served under (KC_HTTP_RELATIVE_PATH)."
  type        = string
  default     = "/keycloak"
}

variable "provisioner_client_id" {
  description = "clientId of the master-realm service account this root authenticates as."
  type        = string
  default     = "tofu-provisioner"
}

variable "provisioner_client_secret" {
  description = <<-EOT
    Secret of the `tofu-provisioner` service account in `master`, as stored by
    kc_bootstrap.py. Export TF_VAR_provisioner_client_secret from kv-org-prod.

    The client itself is deliberately NOT managed by this root: if OpenTofu owned
    it, a bad apply could rotate its own secret and lock the root out with no way
    back except the admin console.
  EOT
  type        = string
  sensitive   = true
}
