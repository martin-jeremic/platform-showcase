# ============================================================================
# TEMPORARY: delete this file after the first successful apply.
# ============================================================================
#
# Import blocks adopting the live realm "org" on https://services.example.com/keycloak
# into module.org. Generated by scripts/keycloak/kc_export.py; the ids are
# Keycloak's internal UUIDs (aliases where the provider imports by alias). Once
# applied, every address below is in state and this file is inert; leaving it in
# place is harmless until someone recreates an object in the console, at which
# point the UUIDs are lies. Remove it and let state be the record.
#
# (Showcase: committed as .example with placeholder UUIDs so `tofu validate` of the
# root does not depend on it. Rename to imports-org.tf for an adoption run.)

locals {
  org_import = {
    keycloak_generic_protocol_mapper_scope = {
      "access-api/access-api-audience" = "client-scope/11111111-1111-1111-1111-111111111111/22222222-2222-2222-2222-222222222222"
      "groups/groups"                  = "client-scope/33333333-3333-3333-3333-333333333333/44444444-4444-4444-4444-444444444444"
    }
    keycloak_group_this = {
      argocd-admins  = "55555555-5555-5555-5555-555555555555"
      grafana-admins = "66666666-6666-6666-6666-666666666666"
    }
    keycloak_openid_client_scope_this = {
      access-api = "11111111-1111-1111-1111-111111111111"
      groups     = "33333333-3333-3333-3333-333333333333"
    }
    keycloak_openid_client_service_account_role_this = {
      "access-sync-client/realm-management/manage-users"  = "77777777-7777-7777-7777-777777777777/88888888-8888-8888-8888-888888888888/99999999-9999-9999-9999-999999999999"
      "access-sync-client/realm-management/query-clients" = "77777777-7777-7777-7777-777777777777/88888888-8888-8888-8888-888888888888/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
    }
    keycloak_openid_client_this = {
      access-api         = "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"
      access-sync-client = "cccccccc-cccc-cccc-cccc-cccccccccccc"
      argocd             = "dddddddd-dddd-dddd-dddd-dddddddddddd"
      hr-app             = "eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee"
    }
  }
}

import {
  to = module.org.keycloak_default_roles.this[0]
  id = "org/ffffffff-ffff-ffff-ffff-ffffffffffff"
}

import {
  for_each = local.org_import.keycloak_generic_protocol_mapper_scope
  to       = module.org.keycloak_generic_protocol_mapper.scope[each.key]
  id       = "org/${each.value}"
}

import {
  for_each = local.org_import.keycloak_group_this
  to       = module.org.keycloak_group.this[each.key]
  id       = "org/${each.value}"
}

import {
  for_each = local.org_import.keycloak_openid_client_scope_this
  to       = module.org.keycloak_openid_client_scope.this[each.key]
  id       = "org/${each.value}"
}

import {
  for_each = local.org_import.keycloak_openid_client_service_account_role_this
  to       = module.org.keycloak_openid_client_service_account_role.this[each.key]
  id       = "org/${each.value}"
}

import {
  for_each = local.org_import.keycloak_openid_client_this
  to       = module.org.keycloak_openid_client.this[each.key]
  id       = "org/${each.value}"
}

import {
  to = module.org.keycloak_realm.this
  id = "org"
}

import {
  to = module.org.keycloak_realm_default_client_scopes.this[0]
  id = "org"
}

import {
  to = module.org.keycloak_realm_optional_client_scopes.this[0]
  id = "org"
}
