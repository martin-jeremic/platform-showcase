# Realm "org" on https://services.example.com/keycloak, generated by scripts/keycloak/kc_export.py.
#
# Values are the live realm verbatim. Re-running the exporter into this
# directory must produce no diff; a diff means the realm changed behind the
# code (drift), or the code changed and was not applied. Generated comments
# only: explanations belong in docs/keycloak-consolidation.md.
#
# (Showcase note: trimmed to a handful of objects; the real file is several hundred
# lines. The SECURITY markers are what the exporter writes for open findings.)

module "org" {
  source = "../modules/realm"

  realm = "org"

  # --- Realm settings ---
  settings = {
    enabled                      = true
    display_name                 = ""
    registration_allowed         = false
    edit_username_allowed        = false
    reset_password_allowed       = false
    remember_me                  = false
    verify_email                 = false
    login_with_email_allowed     = true
    duplicate_emails_allowed     = false
    ssl_required                 = "external"
    default_signature_algorithm  = "RS256"
    revoke_refresh_token         = false
    sso_session_idle_timeout     = "30m"
    sso_session_max_lifespan     = "10h"
    offline_session_idle_timeout = "720h"
    access_token_lifespan        = "5m"
    access_code_lifespan         = "1m"
    browser_flow                 = "browser"
    registration_flow            = "registration"
    direct_grant_flow            = "direct grant"
    reset_credentials_flow       = "reset credentials"
    client_authentication_flow   = "clients"
    docker_authentication_flow   = "docker auth"
    first_broker_login_flow      = "first broker login"
    attributes = {
      "acr.loa.map"         = "{}"
      parRequestUriLifespan = "60"
    }
    # SECURITY: brute-force protection is OFF on this realm (no brute_force_detection block). Finding S4.
    security_headers = {
      x_frame_options                     = "SAMEORIGIN"
      content_security_policy             = "frame-src 'self'; frame-ancestors 'self'; object-src 'none';"
      content_security_policy_report_only = ""
      x_content_type_options              = "nosniff"
      x_robots_tag                        = "none"
      x_xss_protection                    = ""
      strict_transport_security           = "max-age=31536000; includeSubDomains"
      referrer_policy                     = "no-referrer"
    }
  }

  # --- Realm default client scopes (what a new client gets) ---
  default_client_scopes  = ["acr", "basic", "email", "profile", "role_list", "roles", "saml_organization", "web-origins"]
  optional_client_scopes = ["address", "microprofile-jwt", "offline_access", "organization", "phone"]

  # --- Default roles ---
  # SECURITY: default roles include realm-management/manage-users and view-users: every user can administer the realm. Finding S1.
  default_roles = ["offline_access", "realm-management/manage-users", "realm-management/view-users", "uma_authorization"]

  # --- Client scopes ---
  client_scopes = {
    "access-api" = {
      include_in_token_scope = true
      protocol_mappers = {
        "access-api-audience" = {
          protocol_mapper = "oidc-audience-mapper"
          config = {
            "access.token.claim"        = "true"
            "id.token.claim"            = "false"
            "included.client.audience"  = "access-api"
            "introspection.token.claim" = "true"
            "lightweight.claim"         = "false"
          }
        }
      }
    }
    groups = {
      include_in_token_scope = true
      protocol_mappers = {
        groups = {
          protocol_mapper = "oidc-group-membership-mapper"
          config = {
            "access.token.claim"        = "true"
            "claim.name"                = "groups"
            "full.path"                 = "false"
            "id.token.claim"            = "true"
            "introspection.token.claim" = "true"
            "lightweight.claim"         = "false"
            multivalued                 = "true"
            "userinfo.token.claim"      = "true"
          }
        }
      }
    }
  }

  # --- Groups ---
  groups = {
    argocd-admins  = {}
    grafana-admins = {}
  }

  # --- Clients ---
  # use.refresh.tokens is absent on some clients live. Keycloak's effective default for a missing attribute is
  # true, so `use_refresh_tokens = true` is the faithful value, but the provider reads absence as false: the
  # first plan shows `use_refresh_tokens: false -> true` on each of them. The apply writes the attribute
  # explicitly; no behaviour changes. Affected: access-sync-client.
  clients = {
    access-api = {
      access_type                  = "BEARER-ONLY"
      standard_flow_enabled        = false
      direct_access_grants_enabled = false
      service_accounts_enabled     = false
      default_scopes               = ["acr", "basic", "email", "profile", "roles", "web-origins"]
      optional_scopes              = ["address", "microprofile-jwt", "offline_access", "organization", "phone"]
    }
    # live redirectUris ["/*"] are cleared on the first update: inert without a browser flow, and the provider refuses to write them.
    # service account holds realm administration roles: realm-management/manage-users, realm-management/query-clients.
    access-sync-client = {
      access_type                  = "CONFIDENTIAL"
      standard_flow_enabled        = false
      direct_access_grants_enabled = false
      service_accounts_enabled     = true
      default_scopes               = ["acr", "basic", "email", "profile", "roles", "service_account", "web-origins"]
      optional_scopes              = ["address", "microprofile-jwt", "offline_access", "organization", "phone"]
      service_account_client_roles = {
        realm-management = ["manage-users", "query-clients"]
      }
    }
    argocd = {
      name                         = "Argo CD (hub)"
      access_type                  = "CONFIDENTIAL"
      standard_flow_enabled        = true
      direct_access_grants_enabled = false
      service_accounts_enabled     = false
      root_url                     = "https://services.example.com"
      base_url                     = "/argocd"
      valid_redirect_uris          = ["https://services.example.com/argocd/auth/callback"]
      web_origins                  = ["https://services.example.com"]
      default_scopes               = ["acr", "basic", "email", "groups", "profile", "roles", "web-origins"]
      optional_scopes              = ["address", "microprofile-jwt", "offline_access", "organization", "phone"]
    }
    # SECURITY: public browser client without PKCE. Finding S7.
    hr-app = {
      access_type                  = "PUBLIC"
      standard_flow_enabled        = true
      direct_access_grants_enabled = false
      service_accounts_enabled     = false
      root_url                     = "https://services.example.com/hr"
      valid_redirect_uris          = ["https://services.example.com/hr/*"]
      web_origins                  = ["+"]
      default_scopes               = ["access-api", "acr", "basic", "email", "profile", "roles", "web-origins"]
      optional_scopes              = ["address", "microprofile-jwt", "offline_access", "organization", "phone"]
    }
  }
}
