# Copy to terraform.tfvars and fill in real values.
# terraform.tfvars is git-ignored.
#
# Nothing here is a secret — this stack holds no passwords, because the backup job
# authenticates as a managed identity rather than with a storage account key.

# Required: no defaults. Federation binds to exactly one namespace/ServiceAccount pair,
# and these two strings are compared verbatim during token exchange, so a plausible
# default would be worse than no default. They must match the ServiceAccount that the
# backup CronJob in gitops/platform runs as.
mongo_namespace              = "CHANGE-ME"
mongo_backup_service_account = "CHANGE-ME"

# Optional overrides (defaults already match the intended spec):
# subscription_id             = "11111111-1111-1111-1111-111111111111"
# location                    = "swedencentral"
# resource_group_name         = "rg-org-backup"
# storage_account_name        = "stbackuporg"
# container_name              = "mongo-backups"
# backup_identity_name        = "id-org-mongo-backup"

# The cluster to read the OIDC issuer URL from. Managed by ../aks-prod,
# which must be applied first.
# cluster_name                = "aks-org-prod"
# cluster_resource_group_name = "rg-org-aks"

# Durability and retention. retention_days is the one to think about — the backup job
# has no delete permission, so this policy is the only thing that prunes old dumps.
# replication_type       = "GRS"
# soft_delete_days       = 30
# tier_to_cool_days      = 30
# tier_to_cold_days      = 90
# retention_days         = 365
# version_retention_days = 90
