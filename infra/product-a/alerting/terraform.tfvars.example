# Optional. Every input has a committed default, so this stack runs without a
# terraform.tfvars. Copy to terraform.tfvars (git-ignored) only to override a knob.
#
# Do NOT set `clusters` or `teams_channels` here. They are committed defaults in
# variables.tf: that default is the managed set, and a value here silently replaces
# it with one no review has seen. To add a cluster, an audience or a sender, edit
# variables.tf.
#
# Nothing in this stack's INPUTS is a secret. Both credentials are generated by the
# apply and written straight into Key Vault; they exist only there and in state.

# subscription_id           = "33333333-3333-3333-3333-333333333333"
# key_vault_subscription_id = "22222222-2222-2222-2222-222222222222"
# tenant_id                 = "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
# object_prefix             = "alertmanager"   # must equal notifications.keyVault.objectPrefix
# secret_rotation_days      = 180
# secret_lifetime           = "8760h"
