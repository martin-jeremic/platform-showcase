# =============================================================================
# Platform SSO -- Argo CD and Grafana on aks-product-a-prod
# =============================================================================
# Here and not in the module: both run only on this cluster. Put in the shared
# module, the next plan in every other environment would propose creating an Argo
# CD client for an Argo CD it does not run -- manufactured drift in exactly the
# configs this project exists to keep quiet. If another environment ever gets its
# own UI, promote these into the module behind a count flag.
#
# Client secrets are generated by Keycloak; they are read from the admin console or
# the client-secret endpoint and written into Key Vault, never output from here.

locals {
  # Every resource here hangs off the module's realm output rather than
  # var.realm_name: that is the dependency edge that orders realm-before-clients.
  realm_id = module.realm.realm_name

  # Keycloak's own baseline, from the module, because the scope resources are
  # AUTHORITATIVE: listing only "groups" would strip email, profile and roles off
  # the client.
  scopes = module.realm.scope_profiles

  app_url = "https://${local.app_hostnames[0]}"
}

# ---------------------------------------------------------------------------
# Argo CD
# ---------------------------------------------------------------------------
# The client id must equal `clientID` in the argocd-cm oidc.config of the wrapper
# chart: that is the value Argo CD puts in the token request.
resource "keycloak_openid_client" "argocd" {
  realm_id    = local.realm_id
  client_id   = "argocd"
  name        = "Argo CD (aks-product-a-prod)"
  description = "GitOps UI. Group-based access; anyone outside the admin groups gets nothing."
  enabled     = true

  # CONFIDENTIAL: a server-side web app holding its secret. A PUBLIC client would
  # let anyone who reaches the login page complete the code exchange.
  access_type           = "CONFIDENTIAL"
  standard_flow_enabled = true
  implicit_flow_enabled = false
  # Only ever a human at a browser; machine access to Argo CD uses its own tokens.
  direct_access_grants_enabled = false
  service_accounts_enabled     = false

  root_url  = local.app_url
  base_url  = "/argocd"
  admin_url = "${local.app_url}/argocd"

  # EXACT, not a wildcard: Argo CD sends precisely url + /auth/callback, and a
  # wildcard would widen the redirect surface for no benefit.
  valid_redirect_uris             = ["${local.app_url}/argocd/auth/callback"]
  valid_post_logout_redirect_uris = ["${local.app_url}/argocd"]
  web_origins                     = [local.app_url]

  full_scope_allowed = true
  consent_required   = false
}

# `groups` as a DEFAULT scope, not optional. argocd-rbac-cm maps groups to roles.
# Argo CD does request the scope, but making it default removes the dependency on
# it doing so -- and the failure mode without the claim is the quiet kind: login
# SUCCEEDS, the user lands on policy.default, and it looks like a permissions bug.
resource "keycloak_openid_client_default_scopes" "argocd" {
  realm_id       = local.realm_id
  client_id      = keycloak_openid_client.argocd.id
  default_scopes = concat(local.scopes.default_baseline, ["groups"])
}

resource "keycloak_openid_client_optional_scopes" "argocd" {
  realm_id        = local.realm_id
  client_id       = keycloak_openid_client.argocd.id
  optional_scopes = local.scopes.optional_baseline
}

# ---------------------------------------------------------------------------
# Grafana: a DIRECT client in this realm, not a brokered one. The hub's Grafana
# sits behind a dedicated broker realm because it serves several source realms;
# this instance has exactly one, so a broker would be a second realm, an IdP and a
# client in place of one client, buying a seam nothing uses.
# ---------------------------------------------------------------------------
resource "keycloak_openid_client" "grafana" {
  realm_id    = local.realm_id
  client_id   = "grafana"
  name        = "Grafana (aks-product-a-prod)"
  description = "Observability UI. Role from group membership; role_attribute_strict denies anyone unmatched."
  enabled     = true

  access_type                  = "CONFIDENTIAL"
  standard_flow_enabled        = true
  implicit_flow_enabled        = false
  direct_access_grants_enabled = false
  service_accounts_enabled     = false

  root_url  = local.app_url
  base_url  = "/monitoring/grafana"
  admin_url = "${local.app_url}/monitoring/grafana"

  # Must equal Grafana's root_url + /login/generic_oauth. If Grafana's root_url
  # moves, this moves with it; the mismatch surfaces as invalid_redirect_uri, which
  # names neither side.
  valid_redirect_uris             = ["${local.app_url}/monitoring/grafana/login/generic_oauth"]
  valid_post_logout_redirect_uris = ["${local.app_url}/monitoring/grafana"]
  web_origins                     = [local.app_url]

  full_scope_allowed = true
  consent_required   = false
}

resource "keycloak_openid_client_default_scopes" "grafana" {
  realm_id       = local.realm_id
  client_id      = keycloak_openid_client.grafana.id
  default_scopes = concat(local.scopes.default_baseline, ["groups"])
}

# offline_access stays optional: the chart requests it by name, and an optional
# scope that is requested is granted.
resource "keycloak_openid_client_optional_scopes" "grafana" {
  realm_id        = local.realm_id
  client_id       = keycloak_openid_client.grafana.id
  optional_scopes = local.scopes.optional_baseline
}

# ---------------------------------------------------------------------------
# Groups. NAMES ARE NOT FREE CHOICES: each is a literal in a consumer's config
# (argocd-rbac-cm, the Grafana role_attribute_path). Flat, membership-only, read
# out of the token by the module's realm-wide `groups` mapper.
# ---------------------------------------------------------------------------
locals {
  platform_groups = {
    super-admins         = "platform-super-admins" # Grafana Server Admin + Argo CD role:admin
    argocd-admins        = "argocd-admins"         # Argo CD role:admin only
    grafana-admins       = "grafana-admins"        # Grafana Admin (default org)
    grafana-system-admin = "grafana-system-admin"  # Grafana Server Admin; fewer people
  }
}

resource "keycloak_group" "platform" {
  for_each = local.platform_groups

  realm_id = local.realm_id
  name     = each.value
}

# ---------------------------------------------------------------------------
# The bootstrap operator
# ---------------------------------------------------------------------------
# The realm is greenfield: zero users, and registration is off. Without this the
# clients above are configured correctly and no account can use them -- SSO could
# not even be tested.
#
# ON A PASSWORD IN OPENTOFU: temporary = true makes Keycloak expire the credential,
# so the first login forces a reset and the value stops being a usable credential.
# It is a delivery mechanism, not the account's password. Supplied as
# TF_VAR_bootstrap_user_password, never committed, no default.
resource "keycloak_user" "operator" {
  realm_id = local.realm_id
  username = "platform-operator"
  # LOWERCASE: Keycloak normalises the email on write, so a capitalised literal
  # plans a change on every run and never converges.
  email          = "platform-operator@example.com"
  first_name     = "Platform"
  last_name      = "Operator"
  enabled        = true
  email_verified = true

  initial_password {
    value     = var.bootstrap_user_password
    temporary = true
  }

  lifecycle {
    # BOTH entries are load-bearing; the second is not obvious.
    #
    # initial_password -- after the first login the account has a password tofu
    #   does not know. Without this, every apply would reset it back to the (now
    #   stale) bootstrap value and lock the person out.
    #
    # required_actions -- `temporary = true` makes Keycloak add UPDATE_PASSWORD,
    #   which is the entire mechanism that stops the bootstrap value from becoming
    #   the real password. Undeclared, tofu reads it as drift and plans to REMOVE
    #   it, quietly cancelling the forced reset. Declaring ["UPDATE_PASSWORD"] is
    #   worse: Keycloak clears it after the reset, so tofu would force a fresh reset
    #   on every run. Let Keycloak own the field.
    ignore_changes = [initial_password, required_actions]
  }
}

# Authoritative: owns the user's FULL group membership and removes a group added by
# hand. Intended -- membership is what grants admin, so it must not change in a
# console without leaving a trace in git.
resource "keycloak_user_groups" "operator" {
  realm_id = local.realm_id
  user_id  = keycloak_user.operator.id

  group_ids = [
    keycloak_group.platform["argocd-admins"].id,
    keycloak_group.platform["grafana-admins"].id,
    keycloak_group.platform["super-admins"].id,
  ]
}

output "platform_client_ids" {
  description = "Client ids as the consuming charts spell them; cross-check argocd-cm clientID and the Grafana oauth client id."
  value = {
    argocd  = keycloak_openid_client.argocd.client_id
    grafana = keycloak_openid_client.grafana.client_id
  }
}

output "issuer" {
  description = "The OIDC issuer. Must equal the `issuer:` in argocd-cm's oidc.config BYTE FOR BYTE; Argo CD validates the discovery document against that literal."
  value       = "${var.keycloak_url}/realms/${var.realm_name}"
}
